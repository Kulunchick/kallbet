# Copy to `sidecar.env` (next to docker-compose.yml on the server) or to `.env`
# (for a local run from the repository root). Both are git-ignored: never commit
# real values. Every variable kallbet-ai reads is listed here; the tests keep
# this list complete. Details: docs/sidecar.md.

# --- Required ---------------------------------------------------------------

# The server's KALLBET_BOT_SECRET: the shared secret the sidecar registers its
# Bot Users with. Generate one with `openssl rand -hex 32` and put the SAME value
# in the server's kallbet.env. Without it on the server, POST /api/auth/bot
# answers 503 and no Bot User can sign in.
KALLBET_BOT_SECRET=

# Path of the JSON configuration (bots, Invite Links, LLM providers, debate).
# In the container Compose sets it to /config/sidecar.json.
SIDECAR_CONFIG=sidecar.local.json

# --- Odds (all optional; a source with no mapping or key is skipped) --------

# OddsPapi key (free tier: 250 requests a month; the sidecar spends at most 200).
ODDSPAPI_API_KEY=
# HLTV Event id -> one to five OddsPapi tournament ids.
SIDECAR_ODDSPAPI_TOURNAMENTS={"8302":[400014]}
# HLTV Event id -> Polymarket tag slug.
SIDECAR_POLYMARKET_TAGS={"8302":"pgl-major-singapore-2026"}
# Kalshi's public CS2 feed; set to false to skip it.
SIDECAR_KALSHI_ENABLED=true

# --- LLM ---------------------------------------------------------------------

# Only for an `http` provider whose `api_key_env` names this variable: an API key,
# or whatever key an OAuth subscription proxy expects. Leave empty for the
# claude / codex / agy CLIs: they use their own sign-in (docs/sidecar.md).
KALLBET_AI_LLM_API_KEY=

# --- Process (all optional; the values shown are the defaults) ---------------

# Seconds between the starts of two ticks (5 to 3600).
SIDECAR_TICK_SECONDS=60
# A tick running longer than this many seconds is dropped and counted as failed.
SIDECAR_TICK_TIMEOUT_SECONDS=900
# Log filter: error, warn, info, debug, or a tracing directive such as
# `info,kallbet_ai::adapters::llm=debug`.
SIDECAR_LOG=info
# text (key=value lines) or json (one object per line).
SIDECAR_LOG_FORMAT=text
# Heartbeat file the container health check reads. Default: the audit file's
# name with the extension `.health`, e.g. /data/sidecar.health.
#SIDECAR_HEALTH_FILE=/data/sidecar.health
# `kallbet-ai health` fails when the heartbeat is older than this many seconds...
SIDECAR_HEALTH_MAX_AGE_SECONDS=1800
# ...or when this many ticks in a row failed.
SIDECAR_HEALTH_MAX_FAILURES=10
