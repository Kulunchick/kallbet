# Copy to deploy/deploy.env (git-ignored) and fill in. Or export the same
# variables in your shell. deploy.sh reads this file if it exists.

# SSH target: anything `ssh` accepts, e.g. user@host or a Host alias from ~/.ssh/config.
KALLBET_DEPLOY_HOST=
# Optional extra ssh options, e.g. "-i ~/.ssh/id_ed25519 -p 22".
#KALLBET_DEPLOY_SSH_OPTS=
# Directory on the server that holds docker-compose.yml, kallbet.env and backups/.
KALLBET_DEPLOY_DIR=/opt/kallbet
