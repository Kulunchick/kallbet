# Copy to `.env` for local development. `.env` is git-ignored: never commit
# real values. In production these come from the server's environment.

# Address the binary listens on.
#KALLBET_BIND=127.0.0.1:8095

# SQLite database file (created and migrated on start).
#DATABASE_URL=sqlite://kallbet.db

# The built SPA (run `npm run build` in web/).
#KALLBET_WEB_DIR=web/dist

# Dev-only login bypass: POST /api/dev/login {"nickname": "..."} signs in as
# anyone. Off unless `true`. NEVER enable in production.
KALLBET_DEV_LOGIN=true

# DevTools endpoint of the headless Chrome the HLTV adapter loads pages with.
# Locally: `docker run -d --init --shm-size 2g -p 127.0.0.1:9222:9222
# chromedp/headless-shell:stable`, or any Chrome/Edge started with
# `--headless=new --remote-debugging-port=9222`. Unset: HLTV is skipped.
#KALLBET_CHROME_URL=http://127.0.0.1:9222

# Where downloaded team logos are kept (served by /api/teams/{id}/logo).
#KALLBET_LOGO_DIR=logos

# Secrets.
# Telegram bot token (login verification and notifications).
BOT_TOKEN=
# The bot's @username without the @ (the Telegram Login Widget needs it).
BOT_USERNAME=
# PandaScore API token (fallback Data Source). Without it PandaScore is skipped.
PANDASCORE_TOKEN=
